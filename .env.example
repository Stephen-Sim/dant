# Optional local configuration. Existing process environment values take priority.
# Copy to .env for local development. Never commit secrets or copy .env to a VM.
# Host names are restricted to 127.0.0.1 and localhost; remote binding is refused.
DANT_HOST=127.0.0.1

# Development backend and Vite ports. Native desktop IPC remains fixed at 4317.
# Shared native endpoints/routes come from resources/config/protocol.json.
# Authorization rules and protocol limits are named constants, not env options.
DANT_PORT=4317
DANT_DEV_PORT=4318

# Public VM desktop bridge settings; deployed through an explicit allowlist.
# These values must match in the worker and guest services.
# Guest ports cannot use the VM API or bootstrap bridge ports (4317 and 4319).
DANT_GUEST_HOST=127.0.0.1
DANT_GUEST_PORT=4321

# Optional absolute storage locations; omit to keep the normal per-user defaults.
# Changing a location does not move existing data. Never commit private paths.
# DANT_DATA=
# DANT_WORKSPACE_ROOT=
