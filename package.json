{
  "name": "dant",
  "version": "0.4.7",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/core/run.mts --dev",
    "start": "node scripts/core/run.mts",
    "build": "vite build",
    "format": "npm run format:prettier && npm run format:rust && npm run format:go",
    "format:check": "npm run format:prettier:check && npm run format:rust:check && npm run format:go:check",
    "format:prettier": "prettier --write .",
    "format:prettier:check": "prettier --check .",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "format:go": "node scripts/core/go.mts format",
    "format:go:check": "node scripts/core/go.mts format-check",
    "test:core": "node scripts/core/go.mts test",
    "test:core:race": "node scripts/core/go.mts race",
    "check:core": "node scripts/core/go.mts check",
    "generate:contracts": "node scripts/core/generate-contracts.mts",
    "check:contracts": "node scripts/core/generate-contracts.mts --check",
    "build:core": "node scripts/core/build.mts",
    "package:resources": "npm run build && node scripts/package-resources.mts",
    "test": "node scripts/ci/test.mts",
    "test:coverage": "node scripts/ci/typescript-coverage.mts",
    "test:python:coverage": "node scripts/ci/python-coverage.mts",
    "test:native:coverage": "node scripts/native/coverage.mts",
    "test:powershell:coverage": "pwsh -NoLogo -NoProfile -NonInteractive -File scripts/ci/powershell-coverage.ps1",
    "test:bash:coverage": "node scripts/ci/bash-coverage.mts",
    "coverage:inventory": "node scripts/ci/coverage-inventory.mts",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.ui.json --noEmit && tsc --project tsconfig.tests.json --noEmit",
    "check:states": "node scripts/ci/check-state-contracts.mts",
    "desktop": "tauri dev",
    "desktop:build": "npm run package:resources && tauri build && node scripts/package-resources.mts --stage-release",
    "test:core:coverage": "node scripts/core/go.mts coverage"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "dompurify": "^3.2.6",
    "lucide": "^0.468.0",
    "marked": "^16.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/estree": "1.0.9",
    "@types/node": "22.20.5",
    "c8": "12.0.0",
    "linkedom": "0.18.13",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "rollup": "4.64.7",
    "typescript": "7.0.2",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
