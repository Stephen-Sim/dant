{
  "name": "dant",
  "version": "0.4.7-beta.8",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node src/server.mts",
    "start": "node src/server.mts",
    "build": "vite build",
    "format": "npm run format:prettier && npm run format:rust",
    "format:check": "npm run format:prettier:check && npm run format:rust:check",
    "format:prettier": "prettier --write .",
    "format:prettier:check": "prettier --check .",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test": "node scripts/ci/test.mts",
    "test:coverage": "node scripts/ci/coverage.mts",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.ui.json --noEmit && tsc --project tsconfig.tests.json --noEmit",
    "check:states": "node scripts/ci/check-state-contracts.mts",
    "desktop": "npm run build && node scripts/package-resources.mts && tauri dev",
    "desktop:build": "npm run build && node scripts/package-resources.mts && tauri build && node scripts/package-resources.mts --stage-release"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "dompurify": "^3.2.6",
    "express": "^5.1.0",
    "lucide": "^0.468.0",
    "marked": "^16.0.0",
    "multer": "^2.0.2",
    "ws": "^8.18.3",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/estree": "1.0.9",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "@types/yauzl": "3.4.0",
    "linkedom": "0.18.13",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "rollup": "4.64.7",
    "typescript": "7.0.2",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
