{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dant",
  "version": "0.4.7-beta.10",
  "identifier": "com.dant.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4318",
    "beforeDevCommand": "npx vite --host 127.0.0.1 --port 4318"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "dant",
        "width": 1240,
        "height": 820,
        "minWidth": 680,
        "minHeight": 520,
        "backgroundColor": "#fafafa"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:4317 ws://127.0.0.1:4317 https: wss:; img-src 'self' data: blob: http://127.0.0.1:4317; media-src 'self' blob: http://127.0.0.1:4317; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "resources": { "resources/": "backend/" },
    "windows": {
      "nsis": { "displayLanguageSelector": true, "languages": ["English", "SimpChinese"] }
    }
  }
}
