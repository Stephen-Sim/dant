/** Uninstalled functions fail loudly; the fixture executes actual source to replace its selected slots. */
export function uiEntrypointFixture<T extends object>(
  context: T,
): Omit<T, keyof UiMainFunctions> & UiMainFunctions & Omit<Partial<MainBindings>, keyof T> {
  const bindings: Partial<MainBindings> = {
    workspaceLayout: { bind() {}, dispose() {} },
    chatCollections: {
      renderMenu: () => '',
      toggleMenu() {},
      renderMessageActions: () => '',
      renderMarkers: () => '',
      renderPinnedBar: () => '',
      renderModal: () => null,
      bind() {},
      onClose() {},
      dispose() {},
    },
    callCaptionPreferences: {
      enabled: true,
      renderSetting: () => '',
      renderToggle: () => '',
      bind() {},
    },
    progressPanel: {
      visible: false,
      capture() {},
      open() {},
      close() {},
      bind() {},
      render: () => '',
    },
    messageWindow: createMessageWindow(),
    firstRun: {
      render: () => '',
      observe: async () => {},
      handle: async () => false,
      dispose() {},
    },
  };
  return Object.assign(bindings, entrypointSlots, context);
}
